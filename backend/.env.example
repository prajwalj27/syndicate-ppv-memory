# NOTE: this file lives in backend/ for convenience, but the .env you create
# from it needs to live at the REPO ROOT, not inside backend/. Verified against
# the actual code: src/extraction.py calls
#     load_dotenv(Path(__file__).resolve().parent.parent.parent / ".env")
# which resolves from backend/src/extraction.py three directories up to the
# repo root. From the repo root:
#     cp backend/.env.example .env
# then fill in the key below.

# Required — API key for Tensormux's OpenAI-compatible endpoint, used by
# src/extraction.py for LLM-based invoice field extraction.
TENSORMUX_API_KEY=

# Optional — override Tensormux's base URL (default shown below).
TENSORMUX_BASE_URL=https://api.tensormux.com/v1

# Optional — override the extraction model (default shown below).
PPV_EXTRACTION_MODEL=glm-4-7-flash
